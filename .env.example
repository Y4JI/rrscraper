# Supabase PostgreSQL Connection String
# Replace [PROJECT-REF], [YOUR-PASSWORD], and [POOLER-HOST] with your actual Supabase credentials.
# In Supabase: Project Dashboard -> Connect -> Session Pooler (port 5432) or Direct Connection
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres

# Local development is the default. Set these on the host for production.
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=fiction.example.com
